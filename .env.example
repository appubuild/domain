# ============================================================================
#  Safe Home Network — environment configuration
# ----------------------------------------------------------------------------
#  Copy to `.env` for local work, or set these in your hosting dashboard.
#  These values are PUBLIC (they ship in the client bundle). Never put secrets,
#  private API keys or personal data here.
#
#  The site runs without any of these set. Nothing here is required to launch:
#  service phone numbers are already live and the contact form works by handing
#  the finished message to the visitor's email app.
# ============================================================================

# ---------------------------------------------------------------------------
#  PHP API (Phase 2) — leave both blank to keep the static build
# ---------------------------------------------------------------------------
# Base URL of the API, WITHOUT a trailing slash and WITHOUT /v1.
#   https://safehomenetwork.com/api
# When set, the site reads services, numbers, FAQs, settings and SEO from MySQL,
# the contact form posts to POST /v1/leads, and the admin console signs in
# against the real API instead of the demo account. When empty, the site renders
# the bundled content exactly as it did before the API existed.
VITE_API_BASE_URL=

# Name of the readable CSRF cookie set by POST /v1/auth/login.
VITE_CSRF_COOKIE=shn_csrf

# Contact form delivery endpoint (Formspree, Netlify Forms, your API, etc.).
# On Apache/cPanel hosting the bundled public/contact.php does this for you:
#   VITE_CONTACT_ENDPOINT=/contact.php
# Leave blank and the form opens the visitor's email app with the message
# pre-filled and addressed to SITE.contact.email — never a fake success screen.
VITE_CONTACT_ENDPOINT=

# Public spam-protection site key (reCAPTCHA / hCaptcha / Turnstile).
VITE_SPAM_PROTECTION_SITE_KEY=

# Authorized call tracking. Options: callrail | ringba | marketcalls | gtm | none
VITE_CALL_TRACKING_PROVIDER=none
VITE_CALL_TRACKING_ACCOUNT_ID=

# CallRail dynamic number insertion swap target (optional)
VITE_CALLRAIL_SWAP_TARGET=

# Google Analytics 4 measurement id (only loads after analytics consent)
VITE_GA_MEASUREMENT_ID=

# ZIP code lookup provider (no key required). Default: https://api.zippopotam.us
# Swap this if you move to another provider; the client expects the same
# { places: [{ 'place name', state, 'state abbreviation' }] } shape.
VITE_ZIP_LOOKUP_URL=https://api.zippopotam.us
