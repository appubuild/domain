# ---------------------------------------------------------------------------
# DomainFits — public configuration
#
# Everything here is inlined into the static bundle at build time. NEVER put a
# service-role key, AI provider key or registrar credential in this file: those
# belong in Supabase Edge Function secrets (see docs/security.md).
# Copy to .env.local for development, or export in CI before `npm run build`.
# ---------------------------------------------------------------------------

# Canonical origin, with https and no trailing slash. Until this is set the build
# omits canonicals, Open Graph URLs and sitemap entries rather than inventing a host.
NEXT_PUBLIC_APP_URL=https://example.com

# Brand name used in titles, metadata and structured data.
NEXT_PUBLIC_SITE_NAME=DomainFits

# Supabase project URL and the *anon* key (public by design; protected by RLS).
# Leave both empty to build the site from the offline content pack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Data backend: "supabase" once the project is connected, otherwise "local".
NEXT_PUBLIC_DATA_BACKEND=local

# Optional deployed availability Edge Function. When empty, the browser performs
# RDAP lookups directly and every result is labelled accordingly (no live checks
# are invented).
NEXT_PUBLIC_AVAILABILITY_FN_URL=

# Optional deployed affiliate click-through function. When set, every registrar click
# is validated and recorded server-side before the redirect.
NEXT_PUBLIC_AFFILIATE_FN_URL=

# Explicitly opt in to the browser-local Postgres store (development only).
NEXT_PUBLIC_ALLOW_LOCAL_STORE=false

# Short commit hash shown in the footer/build diagnostic.
NEXT_PUBLIC_BUILD_COMMIT=
