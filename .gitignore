# ---------------------------------------------------------------------------
# Nova Studio — repository ignore rules
# Keep generated artefacts, caches and secrets out of version control.
# ---------------------------------------------------------------------------

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
.venv/
venv/
env/
.python-version

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/

# --- Node / frontend --------------------------------------------------------
node_modules/
.vite/
frontend/dist/
frontend/.turbo/
*.tsbuildinfo

# --- Desktop packaging ------------------------------------------------------
apps/desktop/build/
apps/desktop/dist/
apps/desktop/*.spec.bak
*.manifest

# --- Runtime data (never committed) -----------------------------------------
# Application data directory, caches, proxies, autosaves, crash dumps.
.nova/
nova-data/
*.nova.log
crash-*.json

# --- Project artefacts produced by tests / manual runs ----------------------
*.autosave.nova
*.proxy.mp4
*.thumbs.db

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets / credentials --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Large AI model weights -------------------------------------------------
# Models are downloaded at runtime into the user data dir, never into git.
models/
*.bin
*.ggml
*.onnx
*.ct2
