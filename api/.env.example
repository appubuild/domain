# -----------------------------------------------------------------------------
# Safe Home Network — API environment
# Copy to api/.env (never commit the real file) and fill in your host values.
# -----------------------------------------------------------------------------

# Application
APP_NAME="Safe Home Network API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://safehomenetwork.com/api
SITE_URL=https://safehomenetwork.com

# 64 hex characters. Generate with: php -r "echo bin2hex(random_bytes(32));"
# Leave empty on first run and the API creates api/storage/app.key automatically.
APP_KEY=

# Database (cPanel → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=safehomenetwork
DB_USER=shn_api
DB_PASSWORD=change-this-password
DB_CHARSET=utf8mb4

# Frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://safehomenetwork.com,https://www.safehomenetwork.com,http://localhost:5173

# Sessions
SESSION_COOKIE=shn_admin_session
CSRF_COOKIE=shn_csrf
SESSION_LIFETIME=28800
SESSION_IDLE=7200
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Throttling
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT=900
RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW=900
RATE_DEFAULT_MAX=120
RATE_LEAD_MAX=5
RATE_ANALYTICS_MAX=60
RATE_READ_MAX=240
RATE_RESET_MAX=3
AUDIT_RETENTION=365
ANALYTICS_RETENTION=400

# Seconds public reads may be cached by a CDN/proxy (0 = no public caching)
PUBLIC_CACHE_TTL=0

# Uploads
UPLOAD_PATH=
UPLOAD_URL=/api/uploads
UPLOAD_MAX_BYTES=5242880

# Additional analytics script hosts (comma separated, optional)
SCRIPT_HOSTS=

# Optional integrations — leave blank until a real account exists.
LEAD_WEBHOOK_URL=
CALL_TRACKING_PROVIDER=
CALL_TRACKING_KEY=
AFFILIATE_NETWORK=

# Logging
LOG_DIR=
