    },
    "/healthz": {
      "get": {
        "description": "Readiness: the one endpoint that answers before a session token exists.\n\nRegistered by :func:`nova_studio.api.app.create_app` outside every router,\nbecause \"which endpoints need a token\" is a question with exactly one\nexception and the exception should be visible next to the rule.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
