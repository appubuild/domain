{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "additionalProperties": false,
        "description": "What this machine can do, and what it is missing.",
        "properties": {
          "components": {
            "description": "Every probed component, present or not.",
            "items": {
              "$ref": "#/components/schemas/ComponentStatus"
            },
            "title": "Components",
            "type": "array"
          },
          "missing_required": {
            "description": "Required components that are absent; empty when `usable`.",
            "items": {
              "type": "string"
            },
            "title": "Missing Required",
            "type": "array"
          },
          "usable": {
            "description": "Whether every required component is present.",
            "title": "Usable",
            "type": "boolean"
          }
        },
        "required": [
          "usable"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "ComponentStatus": {
        "additionalProperties": false,
        "description": "Whether one optional component is installed here.",
        "properties": {
          "extra": {
            "description": "The optional dependency group that provides it.",
            "title": "Extra",
            "type": "string"
          },
          "installed": {
            "description": "Whether it can be imported on this machine.",
            "title": "Installed",
            "type": "boolean"
          },
          "name": {
            "description": "Importable module name.",
            "title": "Name",
            "type": "string"
          },
          "purpose": {
            "description": "What it is for, in one line.",
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "name",
          "extra",
          "purpose",
          "installed"
        ],
        "title": "ComponentStatus",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Whether the service is up, and nothing else.\n\nDeliberately tiny: it is polled in a loop while the process starts, and it\nis the one endpoint that answers without a session token, so it must not be\nable to disclose anything — or fail for any reason but \"not listening yet\".",
        "properties": {
          "pid": {
            "description": "Process id of the service, for the shell's own diagnostics.",
            "title": "Pid",
            "type": "integer"
          },
          "status": {
            "default": "ok",
            "description": "Always `ok` when this responds at all.",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Nova Studio version, as a semver string.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "pid"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProblemResponse": {
        "additionalProperties": true,
        "description": "The body of every failure, in the one shape the frontend parses.\n\n`code` and `title` say *what kind of thing went wrong* and are what the UI\nlocalises from; `detail`, `remedy` and the extension members say *what\nhappened this time*, and are for the log line and the toast.",
        "properties": {
          "code": {
            "description": "Stable machine code, e.g. `NS-TRANSPORT-404`; the localisation key.",
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "description": "What happened this time, for the log line and the toast.",
            "title": "Detail",
            "type": "string"
          },
          "domain": {
            "description": "Subsystem that produced the error.",
            "title": "Domain",
            "type": "string"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationField"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-field detail, for a request that failed validation.",
            "title": "Fields"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Path of the request that failed.",
            "title": "Instance"
          },
          "remedy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the user can do about it.",
            "title": "Remedy"
          },
          "retryable": {
            "description": "Whether the same operation may succeed if attempted again.",
            "title": "Retryable",
            "type": "boolean"
          },
          "severity": {
            "description": "`warning` (toast), `error` (banner) or `critical` (blocking).",
            "title": "Severity",
            "type": "string"
          },
          "status": {
            "description": "HTTP status, echoed so a logged body is self-contained.",
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short human-readable summary, localised by the frontend.",
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "Stable URI identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "domain",
          "severity",
          "retryable"
        ],
        "title": "ProblemResponse",
        "type": "object"
      },
      "SystemInfoResponse": {
        "additionalProperties": false,
        "description": "Who this session is, for the window title, the About box and bug reports.",
        "properties": {
          "data_dir": {
            "description": "Where this session writes its data (ADR-0014).",
            "title": "Data Dir",
            "type": "string"
          },
          "frozen": {
            "description": "Whether this is a packaged build rather than a source run.",
            "title": "Frozen",
            "type": "boolean"
          },
          "host": {
            "description": "The host the service is bound to; `127.0.0.1` for a session.",
            "title": "Host",
            "type": "string"
          },
          "implementation": {
            "description": "Python implementation: CPython, PyPy, ...",
            "title": "Implementation",
            "type": "string"
          },
          "pid": {
            "description": "Process id of the service.",
            "title": "Pid",
            "type": "integer"
          },
          "platform": {
            "description": "Operating system, as `platform.platform()` reports it.",
            "title": "Platform",
            "type": "string"
          },
          "port": {
            "description": "The port this session chose at startup; `0` when unbound.",
            "title": "Port",
            "type": "integer"
          },
          "project_format_version": {
            "description": "The newest `.nova` format version this build reads and writes.",
            "title": "Project Format Version",
            "type": "integer"
          },
          "python": {
            "description": "Python version string of the running interpreter.",
            "title": "Python",
            "type": "string"
          },
          "version": {
            "description": "Nova Studio version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "project_format_version",
          "python",
          "implementation",
          "platform",
          "frozen",
          "pid",
          "data_dir",
          "host",
          "port"
        ],
        "title": "SystemInfoResponse",
        "type": "object"
      },
      "ValidationField": {
        "description": "One field of a request that did not match the schema.\n\nNamed rather than positional in the payload because the frontend maps these\nonto form fields, and a string it has to parse is a string it will parse\ndifferently in two places.",
        "properties": {
          "field": {
            "description": "Dotted path of the offending field within the request.",
            "title": "Field",
            "type": "string"
          },
          "kind": {
            "description": "Machine-readable error type, e.g. `greater_than_equal`.",
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "description": "What is wrong with it, as pydantic reported it.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "kind"
        ],
        "title": "ValidationField",
        "type": "object"
      }
    },
    "securitySchemes": {
      "Session token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Every capability the editor has is here. The desktop window and the browser dev server are two clients of the same contract.",
    "summary": "The local service behind the Nova Studio editor.",
    "title": "Nova Studio",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/events": {
      "get": {
        "description": "The tail of the event history, as the WebSocket would have sent it.\n\nA client that detects a gap too large for the bus's retained history calls\nthis (or refetches the slice) instead of pretending the gap did not happen.",
        "operationId": "recent_events_api_v1_events_get",
        "parameters": [
          {
            "description": "Return events after this sequence number.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Return events after this sequence number.",
              "minimum": 0,
              "title": "Since",
              "type": "integer"
            }
          },
          {
            "description": "Maximum events to return.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 200,
              "description": "Maximum events to return.",
              "maximum": 2000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Recent Events Api V1 Events Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "No session token, or the wrong one."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "A Host or Origin that is not this session's loopback address."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "No such endpoint."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "The request was refused; the body says why, and whether to retry."
          },
          "416": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "The requested range is no longer retained; refetch the state."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "The request did not match the endpoint's schema."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "An unexpected error; the body names the exception."
          }
        },
        "security": [
          {
            "Session token": []
          }
        ],
        "summary": "Recent events, for a client that fell behind",
        "tags": [
          "events"
        ]
      }
    },
