# Copy this file to .env, then replace the blank database credentials and site values.
# Do not commit or publish the real .env file.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Keep /domain_fit_dynamic while the app lives in that subdirectory. Use an empty value at web root.
APP_BASE_PATH=/domain_fit_dynamic
SITE_ORIGIN=

# Set APP_SECRET to a unique random value of at least 32 characters.
APP_SECRET=
# Optional daily pseudonymous visitor counts; use a different secret from APP_SECRET.
ANALYTICS_SALT=
