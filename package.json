{
  "name": "domainfits",
  "version": "0.1.0",
  "private": true,
  "description": "DomainFits \u2014 domain discovery, brandable naming and domain intelligence platform (static frontend + Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "tsx scripts/prebuild-check.ts && next build && tsx scripts/emit-hosting-config.ts",
    "start": "npx --yes serve out -l 3000 -s",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:a11y",
    "db:seed": "npx supabase db push --include-seed",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "clean": "rm -rf .next out",
    "audit:size": "tsx scripts/audit-bundle.ts",
    "test:a11y": "vitest run tests/a11y",
    "smoke": "tsx scripts/smoke.ts"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
