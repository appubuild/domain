{
  "name": "land-expert",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc -b && vite build --config apps/web/vite.config.ts",
    "test": "vitest run --config apps/web/vite.config.ts",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "typecheck": "tsc -b",
    "test:e2e:cloud": "playwright test --config apps/web/playwright.cloud.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.0",
    "@turf/area": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "i18next": "^25.0.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "pdfmake": "^0.3.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "react-router": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "terra-draw": "^1.38.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.0.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
