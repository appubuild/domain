{
  "name": "safe-home-network",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --force",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "audit": "vite build --ssr scripts/audit.tsx --outDir .smoke --logLevel error && node .smoke/audit.js",
    "smoke": "vite build --ssr scripts/smoke.tsx --outDir .smoke-smoke --logLevel error && node .smoke-smoke/smoke.js",
    "test": "vite build --ssr scripts/test-directory.tsx --outDir .smoke-test --logLevel error && node .smoke-test/test-directory.js"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
